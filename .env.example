# Gitset web app — environment variables.
# Copy to `.env` and fill in. Never commit real values.

# Turso (libSQL) database.
DB_URL=libsql://your-database.turso.io
DB_TOKEN=

# GitHub OAuth App (create one at github.com/settings/developers).
# Callback must match the app's authorization callback URL exactly.
GITHUB_AUTH_CLIENT=
GITHUB_AUTH_SECRET=
GITHUB_AUTH_CALLBACK_URL=http://localhost:4321/api/auth/callback/github

# Gitset API base URL (the backend that serves the generation endpoints).
CORE_API_URL=
