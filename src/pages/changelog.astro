---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "../styles/global.css";
import { SiteHeader } from "../components/SiteHeader";
import { Footer } from "../components/Footer";
import { ChangelogReleaseItem } from "../components/ChangelogReleaseItem";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";
import { marked } from "marked";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);

let releases = [];
let error = null;

marked.setOptions({
    breaks: true,
    gfm: true,
});

try {
    const response = await fetch(
        "https://api.github.com/repos/gitset-dev/gitset/releases",
        {
            headers: {
                Accept: "application/vnd.github.v3+json",
                "User-Agent": "Gitset-Web",
            },
        },
    );

    if (response.ok) {
        const data = await response.json();
        releases = data.map((release: any, index: number) => {
            const rawBody = release.body || "No description provided.";
            const htmlBody = marked.parse(rawBody);

            const isLatest = index === 0 && !release.prerelease;

            return {
                version: release.tag_name,
                date: new Date(release.published_at).toLocaleDateString(
                    "en-US",
                    {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    },
                ),
                title: release.name || release.tag_name,
                description: htmlBody,
                type: release.prerelease
                    ? "prerelease"
                    : isLatest
                      ? "latest"
                      : "release",
                html_url: release.html_url,
            };
        });
    }
} catch (e) {
    error = "Failed to fetch releases from GitHub";
    console.error(e);
}
---

<BaseLayout title="Changelog - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Latest updates and improvements to the Gitset platform."
        />
        <script is:inline>
            (function () {
                const THEME_STORAGE_KEY = "theme";
                const stored = localStorage.getItem(THEME_STORAGE_KEY);
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "light" || stored === "dark" ? stored : "dark";
                document.documentElement.classList.add(theme);
            })();
        </script>
    </Fragment>
    <body
        class="bg-background text-foreground antialiased min-h-screen flex flex-col"
    >
        <SiteHeader client:load showBackButton={true} user={toClientUser(user?.user)} />
        <main class="flex-1 container mx-auto px-4 py-12 max-w-4xl">
            <div class="space-y-8">
                <div class="text-center space-y-3">
                    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                        Changelog
                    </h1>
                    <p class="text-lg text-muted-foreground">
                        See what's new in Gitset.
                    </p>
                </div>

                {
                    error && (
                        <div class="rounded-3xl border border-destructive/50 bg-destructive/10 p-6 text-center">
                            <p class="text-sm text-destructive">{error}</p>
                        </div>
                    )
                }

                {
                    !error && releases.length === 0 && (
                        <div class="rounded-3xl border border-border bg-card p-6 text-center">
                            <p class="text-sm text-muted-foreground">
                                No releases found.
                            </p>
                        </div>
                    )
                }

                {
                    !error && releases.length > 0 && (
                        <div class="relative border-l-2 border-border ml-4 space-y-10 mt-12">
                            {releases.map((release: any) => (
                                <ChangelogReleaseItem
                                    release={release}
                                    client:load
                                />
                            ))}
                        </div>
                    )
                }
            </div>
        </main>
        <Footer client:idle />
    </body>
</BaseLayout>
