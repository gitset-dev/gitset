---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "../styles/global.css";
import { SiteHeader } from "../components/SiteHeader";
import { Footer } from "../components/Footer";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);
---

<BaseLayout title="Contact Support - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Get in touch with the Gitset team — support by email, bugs and feature requests on GitHub."
        />
        <script is:inline>
            (function () {
                const THEME_STORAGE_KEY = "theme";
                const stored = localStorage.getItem(THEME_STORAGE_KEY);
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "light" || stored === "dark"
                        ? stored
                        : prefersDark
                          ? "dark"
                          : "light";
                document.documentElement.classList.add(theme);
            })();
        </script>
    </Fragment>
    <body
        class="bg-background text-foreground antialiased min-h-screen flex flex-col"
    >
        <SiteHeader client:load showBackButton={true} user={toClientUser(user?.user)} />
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-grid"></div>
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-glow"></div>
        <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-14 sm:py-20 max-w-4xl">
            <div class="space-y-12">
                <div class="text-center space-y-3">
                    <p class="eyebrow">Contact</p>
                    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
                        Get in touch
                    </h1>
                    <p class="mx-auto max-w-2xl text-base text-muted-foreground sm:text-lg">
                        Questions, bugs, ideas — pick whichever channel suits
                        you.
                    </p>
                </div>

                <div class="grid gap-4 md:grid-cols-2 md:gap-6">
                    <a
                        href="mailto:support@gitset.dev"
                        class="card-hover group flex flex-col items-start p-6 sm:p-7 bg-card border border-border rounded-2xl shadow-sm text-left"
                    >
                        <div
                            class="h-11 w-11 rounded-xl border border-brand/25 bg-brand/10 flex items-center justify-center mb-5 group-hover:bg-brand/20 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-5 w-5 text-brand"
                            >
                                <rect width="20" height="16" x="2" y="4" rx="2"
                                ></rect>
                                <path
                                    d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="font-semibold text-lg tracking-tight mb-1.5 text-foreground">
                            Email Support
                        </h3>
                        <p class="text-sm text-muted-foreground mb-5">
                            For general inquiries and account support.
                        </p>
                        <span class="mt-auto inline-flex items-center gap-1 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 font-mono text-xs font-medium text-brand"
                            >support@gitset.dev</span
                        >
                    </a>

                    <a
                        href="https://github.com/gitset-dev/gitset-web/issues"
                        target="_blank"
                        rel="noreferrer"
                        class="card-hover group flex flex-col items-start p-6 sm:p-7 bg-card border border-border rounded-2xl shadow-sm text-left"
                    >
                        <div
                            class="h-11 w-11 rounded-xl border border-brand/25 bg-brand/10 flex items-center justify-center mb-5 group-hover:bg-brand/20 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-5 w-5 text-brand"
                            >
                                <path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path>
                                <path d="M9 18c-4.51 2-5-2-7-2"></path>
                            </svg>
                        </div>
                        <h3 class="font-semibold text-lg tracking-tight mb-1.5 text-foreground">
                            GitHub Issues
                        </h3>
                        <p class="text-sm text-muted-foreground mb-5">
                            Report bugs or request features directly.
                        </p>
                        <span class="mt-auto inline-flex items-center gap-1 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 font-mono text-xs font-medium text-brand"
                            >Open an Issue</span
                        >
                    </a>
                </div>

                <div
                    class="ring-gradient relative isolate overflow-hidden bg-card border border-border rounded-3xl px-6 py-10 sm:p-12 shadow-sm text-center space-y-4"
                >
                    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-glow"></div>
                    <h2 class="text-2xl font-semibold tracking-tight text-foreground">
                        Prefer reading the source?
                    </h2>
                    <p
                        class="text-muted-foreground max-w-2xl mx-auto text-sm leading-relaxed"
                    >
                        Gitset is open source. If you'd rather check how
                        something works than ask, the code is the answer —
                        including how your keys are stored and exactly what
                        leaves your machine.
                    </p>
                    <div class="pt-2">
                        <a
                            href="https://github.com/gitset-dev"
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center justify-center rounded-xl text-sm font-semibold transition-colors bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-11 px-6 py-2"
                        >
                            Browse the code
                        </a>
                    </div>
                </div>
            </div>
        </main>
        <Footer client:idle />
    </body>
</BaseLayout>
