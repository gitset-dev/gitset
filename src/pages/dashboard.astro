---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/global.css";
import { SiteHeader } from "@/components/SiteHeader";
import DashboardActions from "@/components/DashboardActions";
import SessionList from "@/components/SessionList";
import ProviderKeysManager from "@/components/ProviderKeysManager";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";
import { db } from "@/db";
import {
    sessions,
    credentials,
    loginLogs,
    messageUsage,
} from "@/db/schema";
import { Footer } from "@/components/Footer";
import { eq, desc, and, ne } from "drizzle-orm";
import {
    X,
    Shield,
    Monitor,
    LogOut,
    Trash2,
    Calendar,
    User,
    Mail,
} from "lucide-react";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);

if (!user) {
    return Astro.redirect("/");
}

const userSessions = await db.query.sessions.findMany({
    where: eq(sessions.userId, user.user.id),
    with: {
        loginLog: true,
    },
    orderBy: [desc(sessions.expiresAt)],
});

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const sessionId = formData.get("sessionId");

    if (action === "revoke" && typeof sessionId === "string") {
        await db.delete(sessions).where(eq(sessions.id, sessionId));
        return Astro.redirect("/dashboard");
    }

    if (action === "revoke_all") {
        const currentSessionId = Astro.cookies.get("app_auth_token")?.value;
        if (currentSessionId) {
            await db
                .delete(sessions)
                .where(
                    and(
                        eq(sessions.userId, user.user.id),
                        ne(sessions.id, currentSessionId),
                    ),
                );
        }
        return Astro.redirect("/dashboard");
    }

    if (action === "delete_account") {
        await db
            .delete(messageUsage)
            .where(eq(messageUsage.userEmail, user.user.userEmail));
        await db.delete(loginLogs).where(eq(loginLogs.userId, user.user.id));
        await db.delete(sessions).where(eq(sessions.userId, user.user.id));
        await db.delete(credentials).where(eq(credentials.id, user.user.id));
        return Astro.redirect("/");
    }

    if (action === "logout") {
        Astro.cookies.delete("app_auth_token", { path: "/" });
        return Astro.redirect("/");
    }
}

const avatarUrl =
    user.user.avatarUrl || `https://github.com/${user.user.gitsetKey}.png`;
const joinedDate = new Date(
    user.user.createdAt || Date.now(),
).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

// A "Set one up" CTA elsewhere on the site sends people here to configure a
// provider; opening the modal for them is the difference between landing on
// the action and landing near it.
const wantsProviderSetup = Astro.url.searchParams.get("setup") === "ai-provider";
---

<BaseLayout title="Dashboard - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            (function () {
                const THEME_STORAGE_KEY = "theme";
                const stored = localStorage.getItem(THEME_STORAGE_KEY);
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "light" || stored === "dark" ? stored : "dark";
                document.documentElement.classList.add(theme);
            })();
        </script>
    </Fragment>
    <body
        class="bg-background text-foreground antialiased min-h-screen flex flex-col"
    >
        <SiteHeader client:load user={toClientUser(user.user)} />

        <main class="relative isolate flex-1">
            <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-80 bg-grid"></div>
            <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-80 bg-glow"></div>
            <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
            <div
                class="mb-8 flex flex-col gap-4 sm:mb-10 md:flex-row md:items-end md:justify-between"
            >
                <div>
                    <p class="eyebrow">Account</p>
                    <h1
                        class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-foreground sm:text-4xl"
                    >
                        Dashboard
                    </h1>
                    <p class="mt-2 text-base text-muted-foreground">
                        Manage your account settings and active sessions.
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-6 md:grid md:grid-cols-2 lg:grid-cols-12 lg:gap-8">

                <div
                    class="contents lg:col-span-4 lg:flex lg:flex-col lg:gap-6"
                >
                    <div
                        class="group relative overflow-hidden rounded-2xl border border-border bg-card text-card-foreground shadow-sm"
                    >
                        <div class="absolute top-4 right-4 z-10">
                            <a
                                href="/api/auth/logout"
                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/20 bg-black/25 text-white backdrop-blur-md transition-colors hover:border-destructive hover:bg-destructive focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/25"
                                title="Log out"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-power"
                                    ><path d="M12 2v10"></path><path
                                        d="M18.4 6.6a9 9 0 1 1-12.77.04"
                                    ></path></svg
                                >
                                <span class="sr-only">Logout</span>
                            </a>
                        </div>
                        <div
                            class="relative h-28 overflow-hidden bg-[radial-gradient(120%_120%_at_0%_0%,color-mix(in_oklch,var(--brand)_55%,transparent),transparent_60%),radial-gradient(100%_100%_at_100%_0%,color-mix(in_oklch,var(--info)_35%,transparent),transparent_60%)] bg-muted"
                        >
                            <div class="absolute inset-0 bg-grid opacity-70 [mask-image:none]"></div>
                        </div>
                        <div class="px-6 pb-6">
                            <div class="relative -mt-12 mb-4">
                                <img
                                    src={avatarUrl}
                                    alt={user.user.gitsetKey}
                                    class="h-24 w-24 rounded-2xl border-4 border-card bg-card object-cover shadow-lg"
                                />
                            </div>
                            <div class="min-w-0 space-y-1">
                                <h2
                                    class="flex items-center gap-2 truncate text-xl font-semibold tracking-tight text-foreground"
                                >
                                    {user.user.username || user.user.gitsetKey}
                                </h2>

                                <p
                                    class="mt-1 flex min-w-0 items-center gap-2 text-sm text-muted-foreground"
                                >
                                    <Mail className="h-3.5 w-3.5 shrink-0" />
                                    <span class="truncate">{user.user.userEmail}</span>
                                </p>
                            </div>

                            <div
                                class="mt-6 space-y-3 border-t border-border pt-4"
                            >
                                <div
                                    class="flex items-center justify-between gap-3 text-sm"
                                >
                                    <span
                                        class="flex items-center gap-2 text-muted-foreground"
                                    >
                                        <Calendar className="h-4 w-4" /> Joined
                                    </span>
                                    <span class="font-mono text-xs font-medium text-foreground"
                                        >{joinedDate}</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="order-last w-full md:order-none lg:order-last md:[&>astro-island>div]:h-full lg:[&>astro-island>div]:h-auto">
                        <DashboardActions client:load />
                    </div>
                </div>

                <div class="flex flex-col gap-6 md:col-span-2 lg:col-span-8">
                    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                    <div class="relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card p-6 shadow-sm">
                        <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand/15 blur-3xl"></div>
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-brand/25 bg-brand/10 text-brand">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3L22 7l-3-3"></path></svg>
                        </span>
                        <h3 class="mt-4 flex items-center gap-2 font-semibold tracking-tight">
                            Bring your own AI
                        </h3>
                        <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted-foreground">
                            Gitset is BYOAI &amp; open source. Add your own
                            provider key (Anthropic, OpenAI, Gemini, OpenRouter,
                            DeepSeek). Keys are encrypted at rest and never sent
                            to your browser.
                        </p>
                        <div class="mt-5">
                            <ProviderKeysManager client:load triggerLabel="Manage AI providers" autoOpen={wantsProviderSetup} />
                        </div>
                    </div>

                    <div class="flex flex-col rounded-2xl border border-border bg-card p-6 shadow-sm">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-brand/25 bg-brand/10 text-brand">
                            <svg class="h-[18px] w-[18px]" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"/></svg>
                        </span>
                        <h3 class="mt-4 flex items-center gap-2 font-semibold tracking-tight">
                            GitHub connection
                        </h3>
                        <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted-foreground">
                            Connected as <span class="font-medium text-foreground">{user.user.username || user.user.gitsetKey}</span>.
                            If you recently joined a GitHub organization, or an
                            organization or repository is missing from the
                            repository selector, grant Gitset access to it and
                            sync your permissions.
                        </p>
                        <div class="mt-5 flex flex-col gap-2 sm:flex-row md:flex-col lg:flex-row xl:flex-col 2xl:flex-row">
                            <a
                                href="/api/auth/github/manage"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
                            >
                                Manage organization access
                            </a>
                            <a
                                href="/api/auth/github?next=/dashboard"
                                class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-input bg-card/60 px-4 text-sm font-medium shadow-xs transition-colors hover:border-brand/30 hover:bg-accent hover:text-accent-foreground"
                            >
                                Re-authorize &amp; Sync
                            </a>
                        </div>
                    </div>
                    </div>

                    <SessionList
                        client:load
                        sessions={userSessions}
                        currentSessionId={Astro.cookies.get("app_auth_token")
                            ?.value}
                    />
                </div>
            </div>
            </div>
        </main>
        <Footer client:idle />
    </body>
</BaseLayout>
