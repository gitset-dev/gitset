---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/global.css";
import { SiteHeader } from "@/components/SiteHeader";
import DashboardActions from "@/components/DashboardActions";
import SessionList from "@/components/SessionList";
import ProviderKeysManager from "@/components/ProviderKeysManager";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";
import { db } from "@/db";
import {
    sessions,
    credentials,
    loginLogs,
    messageUsage,
} from "@/db/schema";
import { Footer } from "@/components/Footer";
import { eq, desc, and, ne } from "drizzle-orm";
import {
    X,
    Shield,
    Monitor,
    LogOut,
    Trash2,
    Calendar,
    User,
    Mail,
} from "lucide-react";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);

if (!user) {
    return Astro.redirect("/");
}

const userSessions = await db.query.sessions.findMany({
    where: eq(sessions.userId, user.user.id),
    with: {
        loginLog: true,
    },
    orderBy: [desc(sessions.expiresAt)],
});

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const sessionId = formData.get("sessionId");

    if (action === "revoke" && typeof sessionId === "string") {
        await db.delete(sessions).where(eq(sessions.id, sessionId));
        return Astro.redirect("/dashboard");
    }

    if (action === "revoke_all") {
        const currentSessionId = Astro.cookies.get("app_auth_token")?.value;
        if (currentSessionId) {
            await db
                .delete(sessions)
                .where(
                    and(
                        eq(sessions.userId, user.user.id),
                        ne(sessions.id, currentSessionId),
                    ),
                );
        }
        return Astro.redirect("/dashboard");
    }

    if (action === "delete_account") {
        await db
            .delete(messageUsage)
            .where(eq(messageUsage.userEmail, user.user.userEmail));
        await db.delete(loginLogs).where(eq(loginLogs.userId, user.user.id));
        await db.delete(sessions).where(eq(sessions.userId, user.user.id));
        await db.delete(credentials).where(eq(credentials.id, user.user.id));
        return Astro.redirect("/");
    }

    if (action === "logout") {
        Astro.cookies.delete("app_auth_token", { path: "/" });
        return Astro.redirect("/");
    }
}

const avatarUrl =
    user.user.avatarUrl || `https://github.com/${user.user.gitsetKey}.png`;
const joinedDate = new Date(
    user.user.createdAt || Date.now(),
).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<BaseLayout title="Dashboard - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            (function () {
                const THEME_STORAGE_KEY = "theme";
                const stored = localStorage.getItem(THEME_STORAGE_KEY);
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "light" || stored === "dark" ? stored : "dark";
                document.documentElement.classList.add(theme);
            })();
        </script>
    </Fragment>
    <body
        class="bg-background text-foreground antialiased min-h-screen flex flex-col"
    >
        <SiteHeader client:load user={toClientUser(user.user)} />

        <main class="flex-1 container mx-auto px-4 py-12 max-w-6xl">
            <div
                class="mb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
            >
                <div>
                    <h1
                        class="text-4xl font-bold tracking-tight text-foreground"
                    >
                        Dashboard
                    </h1>
                    <p class="text-lg text-muted-foreground mt-2">
                        Manage your account settings and active sessions.
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-6 lg:grid lg:gap-8 lg:grid-cols-12">

                <div
                    class="contents lg:col-span-4 lg:flex lg:flex-col lg:gap-6"
                >
                    <div
                        class="rounded-xl border border-border bg-card text-card-foreground shadow-sm overflow-hidden relative group"
                    >
                        <div class="absolute top-4 right-4 z-10">
                            <a
                                href="/api/auth/logout"
                                class="inline-flex items-center justify-center rounded-full text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring bg-destructive/10 text-destructive hover:bg-destructive hover:text-white h-9 w-9 shadow-sm border border-destructive/20"
                                title="Log out"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-power"
                                    ><path d="M12 2v10"></path><path
                                        d="M18.4 6.6a9 9 0 1 1-12.77.04"
                                    ></path></svg
                                >
                                <span class="sr-only">Logout</span>
                            </a>
                        </div>
                        <div
                            class="h-32 bg-gradient-to-r from-brand/20 to-secondary/20"
                        >
                        </div>
                        <div class="px-6 pb-6">
                            <div class="relative -mt-16 mb-4">
                                <img
                                    src={avatarUrl}
                                    alt={user.user.gitsetKey}
                                    class="h-32 w-32 rounded-full border-4 border-background bg-background object-cover shadow-md"
                                />
                            </div>
                            <div class="space-y-1">
                                <h2
                                    class="text-2xl font-bold text-foreground flex items-center gap-2"
                                >
                                    {user.user.username || user.user.gitsetKey}
                                </h2>

                                <p
                                    class="text-sm text-muted-foreground flex items-center gap-2 mt-2"
                                >
                                    <Mail className="h-3 w-3" />
                                    {user.user.userEmail}
                                </p>
                            </div>

                            <div
                                class="mt-6 space-y-3 border-t border-border pt-4"
                            >
                                <div
                                    class="flex items-center justify-between text-sm"
                                >
                                    <span
                                        class="text-muted-foreground flex items-center gap-2"
                                    >
                                        <Calendar className="h-4 w-4" /> Joined
                                    </span>
                                    <span class="font-medium text-foreground"
                                        >{joinedDate}</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="order-last w-full">
                        <DashboardActions client:load />
                    </div>
                </div>

                <div class="lg:col-span-8 flex flex-col gap-6">
                    <div class="rounded-lg border border-border bg-card p-5">
                        <h3 class="font-semibold flex items-center gap-2">
                            Bring your own AI
                        </h3>
                        <p class="text-sm text-muted-foreground mt-1">
                            Gitset is BYOAI &amp; open source. Add your own
                            provider key (Anthropic, OpenAI, Gemini, OpenRouter,
                            DeepSeek). Keys are encrypted at rest and never sent
                            to your browser.
                        </p>
                        <div class="mt-3">
                            <ProviderKeysManager client:load triggerLabel="Manage AI providers" />
                        </div>
                    </div>

                    <div class="rounded-lg border border-border bg-card p-5">
                        <h3 class="font-semibold flex items-center gap-2">
                            GitHub connection
                        </h3>
                        <p class="text-sm text-muted-foreground mt-1">
                            Connected as <span class="font-medium text-foreground">{user.user.username || user.user.gitsetKey}</span>.
                            If you recently joined a GitHub organization, or an
                            organization or repository is missing from the
                            repository selector, grant Gitset access to it and
                            sync your permissions.
                        </p>
                        <div class="mt-3 flex flex-col sm:flex-row gap-2">
                            <a
                                href="/api/auth/github/manage"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4"
                            >
                                Manage organization access
                            </a>
                            <a
                                href="/api/auth/github?next=/dashboard"
                                class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4"
                            >
                                Re-authorize &amp; Sync
                            </a>
                        </div>
                    </div>

                    <SessionList
                        client:load
                        sessions={userSessions}
                        currentSessionId={Astro.cookies.get("app_auth_token")
                            ?.value}
                    />
                </div>
            </div>
        </main>
        <Footer client:idle />
    </body>
</BaseLayout>
