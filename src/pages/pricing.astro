---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/global.css";
import { SiteHeader } from "../components/SiteHeader";
import { Footer } from "../components/Footer";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);
---

<BaseLayout title="Pricing - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Gitset is free and open-source. Bring your own AI key — you pay your provider directly, with no markup and no subscription."
        />
    </Fragment>

    <div class="relative isolate flex min-h-screen flex-col bg-background text-foreground antialiased">
        <SiteHeader
            client:load
            showBackButton={true}
            user={toClientUser(user?.user)}
        />
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-glow"></div>

        <main class="flex-1">
            <div class="mx-auto max-w-5xl px-4 sm:px-6 py-14 sm:py-24">

                <div class="text-center">
                    <h2 class="eyebrow">
                        Pricing
                    </h2>
                    <h1
                        class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-foreground sm:text-6xl"
                    >
                        Free. Open source. Your keys.
                    </h1>
                    <p
                        class="mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-muted-foreground"
                    >
                        Gitset has no plans, no seats, and no token quotas. You
                        bring your own AI provider key and pay your provider
                        directly — we never mark it up, meter it, or sit in the
                        middle.
                    </p>
                </div>

                <div
                    class="ring-gradient relative mx-auto mt-12 max-w-xl overflow-hidden rounded-3xl border border-border bg-card p-6 shadow-xl sm:p-10"
                >
                    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-brand/20 blur-3xl"></div>
                    <div class="relative flex flex-wrap items-end justify-between gap-4">
                        <h3 class="text-lg font-semibold tracking-tight text-foreground">
                            Everything, for everyone
                        </h3>
                        <p class="text-5xl font-semibold tracking-[-0.04em] text-foreground">
                            $0<span
                                class="text-sm font-normal text-muted-foreground"
                                >/forever</span
                            >
                        </p>
                    </div>
                    <ul class="relative mt-8 space-y-3 border-t border-border pt-6 text-sm leading-6 text-foreground">
                        {
                            [
                                "All tools: commits, issues, PRs, READMEs, releases, labels, .gitignore, repo profiles, backups",
                                "Unlimited generations — limited only by your own provider account",
                                "Custom templates and iterative AI refinement on every tool",
                                "Anthropic, OpenAI, Gemini, DeepSeek, OpenRouter, or any OpenAI-compatible endpoint",
                                "Provider keys encrypted at rest; never logged, never sent to the browser",
                                "Web app + CLI, one consistent workflow",
                            ].map((item) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="mt-0.5 h-5 w-5 shrink-0 rounded-full bg-brand/10 p-1 text-brand"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                    <a
                        href={user ? "/dashboard" : "/login"}
                        class="relative mt-8 flex h-12 w-full items-center justify-center rounded-xl bg-primary px-4 text-center text-sm font-semibold text-primary-foreground shadow-[inset_0_1px_0_0_rgb(255_255_255/0.2),0_8px_24px_-6px_var(--glow)] transition-colors hover:bg-primary/90"
                    >
                        {user ? "Open your dashboard" : "Sign in with GitHub"}
                    </a>
                </div>

                <div class="mt-20">
                    <h2
                        class="text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
                    >
                        So what do I actually pay?
                    </h2>
                    <p
                        class="mx-auto mt-3 max-w-2xl text-center text-sm leading-6 text-muted-foreground"
                    >
                        Only your AI provider's normal API rates, billed by them
                        to you. Typical Gitset generations use a few thousand
                        tokens — fractions of a cent on most models. Many
                        providers also offer free tiers that work fine for
                        day-to-day use.
                    </p>
                    <div class="mt-8 grid gap-4 sm:grid-cols-3">
                        {
                            [
                                {
                                    title: "You hold the key",
                                    body: "Add your provider key once in AI Providers. Rotate or remove it anytime — it's yours, not ours.",
                                },
                                {
                                    title: "No middleman billing",
                                    body: "Requests run against your provider account at their list prices. Gitset adds zero margin.",
                                },
                                {
                                    title: "Open source",
                                    body: "The code is public. Audit how your keys are stored and exactly what leaves your machine.",
                                },
                            ].map((card) => (
                                <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
                                    <h3 class="text-sm font-semibold text-foreground">
                                        {card.title}
                                    </h3>
                                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                        {card.body}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </main>

        <Footer client:idle />
    </div>
</BaseLayout>
