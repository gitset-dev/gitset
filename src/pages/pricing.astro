---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/global.css";
import { SiteHeader } from "../components/SiteHeader";
import { Footer } from "../components/Footer";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);
---

<BaseLayout title="Pricing - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Gitset is free and open-source. Bring your own AI key — you pay your provider directly, with no markup and no subscription."
        />
    </Fragment>

    <div class="flex min-h-screen flex-col bg-background text-foreground antialiased">
        <SiteHeader
            client:load
            showBackButton={true}
            user={toClientUser(user?.user)}
        />

        <main class="flex-1">
            <div class="mx-auto max-w-4xl px-6 py-16 sm:py-24">

                <div class="text-center">
                    <h2 class="text-base font-semibold leading-7 text-brand">
                        Pricing
                    </h2>
                    <h1
                        class="mt-2 text-4xl font-bold tracking-tight text-foreground sm:text-5xl"
                    >
                        Free. Open source. Your keys.
                    </h1>
                    <p
                        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted-foreground"
                    >
                        Gitset has no plans, no seats, and no token quotas. You
                        bring your own AI provider key and pay your provider
                        directly — we never mark it up, meter it, or sit in the
                        middle.
                    </p>
                </div>

                <div
                    class="mx-auto mt-12 max-w-lg rounded-3xl bg-card p-8 ring-1 ring-border"
                >
                    <div class="flex items-baseline justify-between gap-x-4">
                        <h3 class="text-lg font-semibold leading-8 text-foreground">
                            Everything, for everyone
                        </h3>
                        <p class="text-3xl font-bold text-foreground">
                            $0<span
                                class="text-sm font-normal text-muted-foreground"
                                >/forever</span
                            >
                        </p>
                    </div>
                    <ul class="mt-6 space-y-3 text-sm leading-6 text-foreground">
                        {
                            [
                                "All tools: commits, issues, PRs, READMEs, releases, labels, .gitignore, repo profiles, backups",
                                "Unlimited generations — limited only by your own provider account",
                                "Custom templates and iterative AI refinement on every tool",
                                "Anthropic, OpenAI, Gemini, DeepSeek, OpenRouter, or any OpenAI-compatible endpoint",
                                "Provider keys encrypted at rest; never logged, never sent to the browser",
                                "Web app + CLI, one consistent workflow",
                            ].map((item) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="mt-1 h-4 w-4 shrink-0 text-brand"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                    <a
                        href={user ? "/dashboard" : "/login"}
                        class="mt-8 block w-full rounded-lg bg-primary px-4 py-3 text-center text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
                    >
                        {user ? "Open your dashboard" : "Sign in with GitHub"}
                    </a>
                </div>

                <div class="mt-16">
                    <h2
                        class="text-center text-2xl font-semibold text-foreground"
                    >
                        So what do I actually pay?
                    </h2>
                    <p
                        class="mx-auto mt-3 max-w-2xl text-center text-sm leading-6 text-muted-foreground"
                    >
                        Only your AI provider's normal API rates, billed by them
                        to you. Typical Gitset generations use a few thousand
                        tokens — fractions of a cent on most models. Many
                        providers also offer free tiers that work fine for
                        day-to-day use.
                    </p>
                    <div class="mt-8 grid gap-4 sm:grid-cols-3">
                        {
                            [
                                {
                                    title: "You hold the key",
                                    body: "Add your provider key once in AI Providers. Rotate or remove it anytime — it's yours, not ours.",
                                },
                                {
                                    title: "No middleman billing",
                                    body: "Requests run against your provider account at their list prices. Gitset adds zero margin.",
                                },
                                {
                                    title: "Open source",
                                    body: "The code is public. Audit how your keys are stored and exactly what leaves your machine.",
                                },
                            ].map((card) => (
                                <div class="rounded-3xl bg-card p-6 ring-1 ring-border">
                                    <h3 class="text-sm font-semibold text-foreground">
                                        {card.title}
                                    </h3>
                                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                        {card.body}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </main>

        <Footer client:idle />
    </div>
</BaseLayout>
