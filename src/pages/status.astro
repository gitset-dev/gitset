---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "../styles/global.css";
import { SiteHeader } from "../components/SiteHeader";
import { Footer } from "../components/Footer";
import { StatusDashboard } from "../components/StatusDashboard";
import getUser from "@/lib/getUser";
import { toClientUser } from "@/lib/clientUser";

const user = await getUser(Astro.cookies.get("app_auth_token")?.value);
---

<BaseLayout title="GitHub Services Status - Gitset">
    <Fragment slot="head">
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Real-time status of GitHub services and API availability with detailed incident tracking and service monitoring."
        />
        <meta property="og:title" content="GitHub Services Status - Gitset" />
        <meta
            property="og:description"
            content="Monitor GitHub services status in real-time"
        />
        <script is:inline>
            (function () {
                const THEME_STORAGE_KEY = "theme";
                const stored = localStorage.getItem(THEME_STORAGE_KEY);
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "light" || stored === "dark"
                        ? stored
                        : prefersDark
                          ? "dark"
                          : "light";
                document.documentElement.classList.add(theme);
            })();
        </script>
    </Fragment>
    <body
        class="bg-background text-foreground antialiased min-h-screen flex flex-col"
    >
        <SiteHeader client:load showBackButton={true} user={toClientUser(user?.user)} />
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-glow"></div>
        <main class="flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 max-w-7xl">
            <div class="space-y-8">
                <div class="text-center space-y-3">
                    <p class="eyebrow">Live monitor</p>
                    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
                        GitHub Services Status
                    </h1>
                    <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto">
                        Real-time monitoring of GitHub services and API
                        availability. Click on any service to view detailed
                        uptime statistics and incident history.
                    </p>
                </div>

                <StatusDashboard client:load />

                <div class="rounded-2xl border bg-card p-6 sm:p-8 mt-8 shadow-sm">
                    <h3 class="text-lg font-semibold tracking-tight mb-4">
                        About This Status Page
                    </h3>
                    <div class="space-y-3 text-sm text-muted-foreground">
                        <p>
                            This page displays real-time status information for
                            GitHub services, including API endpoints, Git
                            operations, GitHub Pages, GitHub Actions, and more.
                            Data is sourced directly from GitHub's official
                            status API at githubstatus.com.
                        </p>
                        <p>
                            Status updates are refreshed automatically every
                            minute. You can also manually refresh the data using
                            the refresh button. Click on any service card to
                            view detailed uptime statistics, historical
                            performance, and service-specific incidents.
                        </p>
                        <div class="flex flex-wrap gap-2 mt-5 pt-5 border-t">
                            <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs">
                                <span class="w-2 h-2 bg-green-600 rounded-full"
                                ></span>
                                <span>Operational</span>
                            </div>
                            <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs">
                                <span class="w-2 h-2 bg-yellow-600 rounded-full"
                                ></span>
                                <span>Degraded Performance</span>
                            </div>
                            <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs">
                                <span class="w-2 h-2 bg-orange-600 rounded-full"
                                ></span>
                                <span>Partial Outage</span>
                            </div>
                            <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs">
                                <span class="w-2 h-2 bg-red-600 rounded-full"
                                ></span>
                                <span>Major Outage</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <Footer client:idle />
    </body>
</BaseLayout>
